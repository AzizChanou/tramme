{
  "$schema": "../../schema/tramme-1.schema.json",
  "schema": "tramme/1",
  "meta": {"title":"Hello","description":"Minimal demo: keyframes, expression, spring."},
  "tokens": {
    "ink": {"type":"color","value":"#1C1917"},
    "paper": {"type":"color","value":"#F5F0E8"},
    "goldA": {"type":"color","value":"#E5B965"},
    "goldB": {"type":"color","value":"#B78534"},
    "swift": {"type":"ease","value":[0.16,1,0.3,1]}
  },
  "assets": {},
  "root": "main",
  "compositions": {
    "main": {
      "name": "Hello",
      "width": 1080,
      "height": 1080,
      "fps": 30,
      "duration": 3,
      "background": "@ink",
      "motionBlur": {"samples":8,"shutter":0.5},
      "effects": [
        {"id":"grain","type":"look.grain","props":{"amount":0.02,"seed":{"$expr":"frame + 1"}}}
      ],
      "layers": {
        "pill": {
          "type": "shape.rect",
          "name": "Pillar",
          "transform": {
            "position": {
              "$k": [{"t":0,"v":[540,1700]},{"t":0.6,"v":[540,540]}],
              "$mod": [{"type":"spring","freq":1.8,"damping":0.35}]
            },
            "rotation": {"$expr":"Math.sin(t * 3) * 8"}
          },
          "props": {
            "size": [240,600],
            "radius": 24,
            "fill": {
              "type": "linear",
              "from": [-120,-300],
              "to": [120,300],
              "stops": [[0,"@goldA"],[1,"@goldB"]]
            }
          }
        },
        "ring": {
          "type": "shape.ellipse",
          "in": 1,
          "out": 3,
          "transform": {"position":[540,540],"opacity":{"$k":[{"t":1,"v":0.6},{"t":2.5,"v":0}]}},
          "props": {
            "size": {"$k":[{"t":1,"v":[300,300],"ease":"@swift"},{"t":2.5,"v":[1100,1100]}]},
            "fill": null,
            "stroke": "@paper",
            "strokeWidth": 6
          }
        },
        "title": {
          "type": "text",
          "transform": {"position":[540,960],"opacity":{"$k":[{"t":0.5,"v":0},{"t":0.9,"v":1}]}},
          "props": {
            "text": "Hello",
            "size": 96,
            "weight": {"$k":[{"t":0.5,"v":300,"ease":"@swift"},{"t":1,"v":800}]},
            "color": "@paper",
            "align": "center"
          }
        }
      },
      "order": ["pill","ring","title"]
    }
  }
}
