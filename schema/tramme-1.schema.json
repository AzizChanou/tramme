{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "tramme/1"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": {}
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "color",
              "number",
              "ease",
              "string",
              "vec2"
            ]
          },
          "value": {},
          "description": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "font",
              "audio",
              "video",
              "module",
              "json"
            ]
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "box": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "type",
          "src"
        ],
        "additionalProperties": false
      }
    },
    "compositions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "background": {},
          "motionBlur": {
            "type": "object",
            "properties": {
              "samples": {},
              "shutter": {}
            },
            "required": [
              "samples",
              "shutter"
            ],
            "additionalProperties": false
          },
          "camera": {
            "type": "object",
            "properties": {
              "pan": {},
              "zoom": {},
              "perspective": {},
              "focus": {},
              "blur": {}
            },
            "additionalProperties": false
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "t": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "duration": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "t"
              ],
              "additionalProperties": false
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "enabled": {
                  "type": "boolean"
                },
                "props": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "sound": {
            "type": "object",
            "properties": {
              "loudness": {},
              "room": {}
            },
            "additionalProperties": false
          },
          "layers": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "in": {
                  "type": "number"
                },
                "out": {
                  "type": "number"
                },
                "visible": {
                  "type": "boolean"
                },
                "locked": {
                  "type": "boolean"
                },
                "clip": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "blend": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "multiply",
                    "screen",
                    "overlay",
                    "darken",
                    "lighten",
                    "add"
                  ]
                },
                "transform": {
                  "type": "object",
                  "properties": {
                    "anchor": {},
                    "position": {},
                    "scale": {},
                    "rotation": {},
                    "opacity": {},
                    "depth": {}
                  },
                  "additionalProperties": false
                },
                "props": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+$"
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "enabled": {
                        "type": "boolean"
                      },
                      "props": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "id",
                      "type"
                    ],
                    "additionalProperties": false
                  }
                },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        "required": [
          "name",
          "width",
          "height",
          "fps",
          "duration",
          "layers",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "root": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    }
  },
  "required": [
    "schema",
    "meta",
    "tokens",
    "assets",
    "compositions",
    "root"
  ],
  "additionalProperties": false
}
