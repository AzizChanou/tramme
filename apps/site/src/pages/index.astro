---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Made from '../components/Made.astro';
import Inside from '../components/Inside.astro';
import Editor from '../components/Editor.astro';
import Assistant from '../components/Assistant.astro';
import Render from '../components/Render.astro';
import OpenSource from '../components/OpenSource.astro';
import Footer from '../components/Footer.astro';
---

<Base title="tramme, motion design written as data" description="An open-source motion design engine and editor. You and the AI edit the same JSON document, and the preview is the export.">
  <Nav />
  <main>
    <Hero />
    <Made />
    <Inside />
    <Editor />
    <Assistant />
    <Render />
    <OpenSource />
  </main>
  <Footer />
</Base>
