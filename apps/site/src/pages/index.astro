---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Made from '../components/Made.astro';
import Inside from '../components/Inside.astro';
import Editor from '../components/Editor.astro';
import Assistant from '../components/Assistant.astro';
import Render from '../components/Render.astro';
import OpenSource from '../components/OpenSource.astro';
import Footer from '../components/Footer.astro';
import { landingData, SITE } from '../lib/site';
import { previewUrl } from '../lib/preview';
import { SYSTEMS } from '../../../desktop/downloads.ts';

// what the search engines read of the page: the site, the app, its code
const systems = [...new Set(__RELEASE__?.installers.map((i) => SYSTEMS[i.os]))];
const data = landingData(Astro.site!, previewUrl(Astro.site), systems);
---

<Base title={SITE.title} description={SITE.description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(data)} />
  <Nav />
  <main>
    <Hero />
    <Made />
    <Inside />
    <Editor />
    <Assistant />
    <Render />
    <OpenSource />
  </main>
  <Footer />
</Base>
