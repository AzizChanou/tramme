---
// Light or dark, on the landing page and in the docs (in place of Starlight's
// select). Light until the visitor picks dark; the choice is kept under
// Starlight's 'starlight-theme' key (read by ThemeProvider.astro). It shows
// the theme in use.
import Sun from '@phosphor-icons/core/assets/regular/sun.svg';
import Moon from '@phosphor-icons/core/assets/regular/moon.svg';
---

<button type="button" class="theme" data-theme-toggle aria-label="Switch to the dark theme">
  <Sun class="i-sun" aria-hidden="true" />
  <Moon class="i-moon" aria-hidden="true" />
</button>

<script>
  const root = document.documentElement;
  // the docs draw it twice (the header, the phone menu)
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const show = (theme: string) => {
    root.dataset.theme = theme;
    for (const b of buttons) b.setAttribute('aria-label', theme === 'dark' ? 'Switch to the light theme' : 'Switch to the dark theme');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.body).backgroundColor);
  };
  for (const b of buttons) b.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    show(next);
    try { localStorage.setItem('starlight-theme', next); } catch { /* remembered for this page only */ }
  });
  show(root.dataset.theme === 'dark' ? 'dark' : 'light');
</script>

<style>
  .theme {
    display: grid; place-items: center; width: 36px; height: 36px; flex: none;
    border: 1px solid var(--line-2); border-radius: 999px; background: transparent; color: var(--ink-2); cursor: pointer;
    transition: background-color 0.2s var(--ease, ease), color 0.2s var(--ease, ease);
  }
  .theme:hover { background: var(--hover); color: var(--ink); }
  .theme svg { width: 17px; height: 17px; }
  .i-sun, :global([data-theme='light']) .i-moon { display: none; }
  :global([data-theme='light']) .i-sun { display: block; }
</style>
