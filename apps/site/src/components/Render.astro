---
import Code from './Code.astro';
import Head from './Head.astro';
import { FORMATS } from '../lib/formats';

const CLI = `# a video, a vector animation and two stills, from the repository's examples
$ tramme render examples/showcase --format mp4
$ tramme export examples/hello --format lottie
$ tramme still examples/anime --t 0.5,1.2`;
---

<section class="section" id="render">
  <div class="wrap">
    <Head title="The preview is the export." more="Each frame is a pure function of time, drawn by the same engine everywhere." />
    <ul class="formats" role="list" data-reveal>
      {FORMATS.map(({ name, what }) => (
        <li><strong>{name}</strong><span>{what}</span></li>
      ))}
    </ul>
    <div class="cli" data-reveal>
      <Code lang="sh" title="Terminal" code={CLI} />
    </div>
  </div>
</section>

<style>
  .formats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; list-style: none;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden;
  }
  li { display: grid; align-content: space-between; gap: 16px; min-height: clamp(128px, 12vw, 176px); padding: clamp(18px, 2.2vw, 28px); background: var(--bg); transition: background-color 0.25s var(--ease); }
  li:hover { background: var(--panel); }
  strong { font-size: clamp(1.5rem, 2.6vw, 2.25rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.1; }
  span { font-size: 0.875rem; color: var(--ink-3); }
  .cli { margin-top: 20px; }
  @media (max-width: 820px) { .formats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
