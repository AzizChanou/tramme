---
import Head from './Head.astro';
import Media from './Media.astro';
import { example } from '../lib/examples';

// the examples beside the hero's: the film across the page, then two side by
// side; each placeholder lit with its example's background and light
const TILES = [
  { id: 'launch-film', wide: true, tint: ['#0b0f12', '#2ec4b6'], text: '45 seconds on the beat: nested compositions, a 2.5D camera, motion that follows the sound, music written as code.' },
  { id: 'anime', wide: false, tint: ['#1e2a5c', '#f6a86b'], text: 'Frame-by-frame drawings on an exposure sheet, in three shots.' },
  { id: 'showreel', wide: false, tint: ['#111316', '#ff4f7b'], text: 'Made by the assistant: kinetic type, shapes, a counter, a shader smoke and a camera look.' },
] as const;
---

<section class="section" id="made">
  <div class="wrap">
    <Head title="Made with tramme." more="Every example is in the repository, ready to open and take apart." />
    <div class="grid">
      {TILES.map(({ id, wide, tint, text }) => {
        const ex = example(id);
        return (
          <figure class:list={['tile', { wide }]} data-reveal>
            <Media id={id} width={ex.width} height={ex.height} duration={ex.duration} tint={[...tint]} label={`${ex.name}, made with tramme. ${text}`} />
            <figcaption class="caption"><strong>{ex.name}.</strong> {text}</figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 48px 20px; margin-top: clamp(40px, 5vw, 64px); }
  .tile { margin: 0; display: grid; grid-template-rows: 1fr auto; gap: 14px; grid-column: span 6; }
  .wide { grid-column: span 12; }

  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .tile, .wide { grid-column: auto; }
  }
</style>
