---
import Head from './Head.astro';
import Media from './Media.astro';
import { example } from '../lib/examples';

// the examples beside the hero's: a wide one and a square one, then the other
// way round; each placeholder lit with its example's background and light
const TILES = [
  { id: 'anime', wide: true, tint: ['#1e2a5c', '#f6a86b'], text: 'Frame-by-frame drawings on an exposure sheet, in three shots.' },
  { id: 'night-sky', wide: false, tint: ['#070b1a', '#f3ebd3'], text: 'A moon and a star field, drawn by a project plugin.' },
  { id: 'hello', wide: false, tint: ['#1c1917', '#e5b965'], text: 'Keyframes, an expression and a spring.' },
  { id: 'road-trip', wide: true, tint: ['#1b2833', '#f0b46a'], text: 'One list of events drives the counters, the tags and the receipt.' },
] as const;
---

<section class="section" id="made">
  <div class="wrap">
    <Head title="Made with tramme." more="Every example is in the repository, ready to open and take apart." />
    <div class="grid">
      {TILES.map(({ id, wide, tint, text }) => {
        const ex = example(id);
        return (
          <figure class:list={['tile', { wide }]} data-reveal>
            <Media id={id} width={ex.width} height={ex.height} duration={ex.duration} tint={[...tint]} label={`${ex.name}, made with tramme. ${text}`} />
            <figcaption class="caption"><strong>{ex.name}.</strong> {text}</figcaption>
          </figure>
        );
      })}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 48px 20px; margin-top: clamp(40px, 5vw, 64px); }
  .tile { margin: 0; display: grid; grid-template-rows: 1fr auto; gap: 14px; grid-column: span 4; }
  .wide { grid-column: span 8; }
  /* the square ones take the height of the wide one beside them */
  .tile:not(.wide) :global(.media) { aspect-ratio: auto; }

  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .tile, .wide { grid-column: auto; }
    .tile:not(.wide) :global(.media) { aspect-ratio: var(--ratio); }
  }
</style>
