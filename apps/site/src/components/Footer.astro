---
import Brand from './Brand.astro';
import { docHref } from '../lib/docs';
import { REPO, repoFile } from '../lib/links';
---

<footer class="foot">
  <div class="wrap row">
    <Brand />
    <p>© 2026 Aziz Chanou</p>
    <ul role="list">
      <li><a href={docHref('')}>Docs</a></li>
      <li><a href={docHref('document')}>Document format</a></li>
      <li><a href={REPO}>GitHub</a></li>
      <li><a href={repoFile('CHANGELOG.md')}>Changelog</a></li>
      <li><a href={repoFile('LICENSE')}>Apache-2.0</a></li>
    </ul>
  </div>
</footer>

<style>
  .foot { margin-top: var(--section); padding-block: 28px 40px; border-top: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }
  p { font-size: 0.875rem; color: var(--ink-3); }
  ul { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0 0 0 auto; padding: 0; list-style: none; }
  a { font-size: 0.875rem; color: var(--ink-2); text-decoration: none; }
  a:hover { color: var(--ink); }
  @media (max-width: 820px) { ul { margin-left: 0; width: 100%; } }
</style>
