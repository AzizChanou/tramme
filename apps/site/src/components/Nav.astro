---
import Brand from './Brand.astro';
import RepoLink from './RepoLink.astro';
---

<header class="nav">
  <nav class="wrap row" aria-label="Main">
    <a class="home" href="/" aria-label="tramme, home"><Brand /></a>
    <ul class="links" role="list">
      <li><a href="#made">Examples</a></li>
      <li><a href="#inside">Document</a></li>
      <li><a href="#editor">Editor</a></li>
      <li><a href="#assistant">Assistant</a></li>
      <li><a href="#render">Export</a></li>
    </ul>
    <RepoLink small />
  </nav>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid transparent; }
  .row { display: flex; align-items: center; gap: 32px; height: var(--nav); }
  .home { text-decoration: none; font-size: 1.05rem; }
  .links { display: flex; gap: 28px; margin: 0 auto; padding: 0; list-style: none; }
  .links a { color: var(--ink-2); text-decoration: none; font-size: 0.875rem; transition: color 0.2s var(--ease); }
  .links a:hover { color: var(--ink); }
  /* a hairline under the bar once the page moves under it */
  @supports (animation-timeline: scroll()) {
    .nav { animation: ruled linear both; animation-timeline: scroll(); animation-range: 0 64px; }
    @keyframes ruled { to { border-bottom-color: var(--line); } }
  }
  @media (max-width: 860px) {
    .links { display: none; }
    .row > :global(.btn) { margin-left: auto; }
  }
</style>
