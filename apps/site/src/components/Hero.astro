---
import Media from './Media.astro';
import RepoLink from './RepoLink.astro';
import { docHref } from '../lib/docs';
import { example } from '../lib/examples';

const show = example('showcase');
const about = 'A shader sky, particles, nested compositions, layer effects and modifiers.';
---

<section class="hero">
  <div class="wrap top">
    <h1><span>Motion design,</span> <span class="quiet">written as data.</span></h1>
    <div class="side">
      <p>An open-source engine and editor. You and the AI edit the same JSON document, with the same undo.</p>
      <div class="ctas">
        <RepoLink />
        <a class="btn btn-ghost" href={docHref('')}>Read the docs</a>
      </div>
    </div>
  </div>

  <div class="wrap-wide stage">
    <Media id="showcase" width={show.width} height={show.height} duration={show.duration} tint={['#0b0d14', '#7390ff']} label={`${show.name}, made with tramme. ${about}`} />
    <p class="caption"><strong>{show.name}.</strong> {about}</p>
  </div>
</section>

<style>
  .hero { padding-top: clamp(48px, 8vw, 104px); }
  .top { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 32px 64px; align-items: end; }
  h1 { font-size: clamp(2.75rem, 6.3vw, 5.75rem); line-height: 0.98; letter-spacing: -0.048em; }
  h1 span { display: block; }
  .quiet { color: var(--ink-3); }
  .side { display: grid; gap: 28px; max-width: 30rem; padding-bottom: 0.35rem; }
  .side p { font-size: 1.125rem; line-height: 1.55; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .stage { position: relative; margin-top: clamp(48px, 6.5vw, 88px); }
  /* the clip's light, spilling on the page around it */
  .stage::before {
    content: ''; position: absolute; inset: -18% 4% 30%; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(115, 144, 255, 0.13), transparent 72%);
  }
  .stage :global(.media) { box-shadow: var(--lift); }
  .caption { margin-top: 16px; }

  @media (prefers-reduced-motion: no-preference) {
    h1 span, .side, .stage { animation: enter 0.9s var(--ease) both; }
    h1 span + span { animation-delay: 70ms; }
    .side { animation-delay: 150ms; }
    .stage { animation-delay: 240ms; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(20px); } }

  @media (max-width: 900px) { .top { grid-template-columns: minmax(0, 1fr); } }
</style>
