# Model of apps/worker/.dev.vars: copy it to .dev.vars and fill in the keys.
# Never put real keys in this file (it is kept in git).
# Deployed app: the same names as Cloudflare secrets (npx wrangler secret put NAME).

# Claude through the server (fallback when the local companion is not running)
ANTHROPIC_API_KEY=

# Other providers (OpenAI chat format)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=

# Sounds made by a provider (sound effects, music, voice-overs): ElevenLabs makes
# all three; a voice-over can also come from OpenAI or Gemini with the keys above
ELEVENLABS_API_KEY=
